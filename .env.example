# ========================================================
# SkillTracker Environment Variables Configuration
# Copy this file to .env and fill in your local MySQL credentials
# NEVER commit your actual password or secrets to version control
# ========================================================

# MySQL Database Connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=skilltracker_db

# Alternative environment variable names (supported automatically)
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=your_mysql_password_here
# MYSQL_DATABASE=skilltracker_db

# JWT Secret for Session Authentication (replace with any random string)
JWT_SECRET=your_jwt_secret_key_change_in_production

# Server Port (default: 3000)
PORT=3000

# App URL (automatically provided in AI Studio or localhost)
APP_URL=http://localhost:3000
